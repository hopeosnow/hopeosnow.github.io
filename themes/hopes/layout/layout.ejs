<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= config.title %> · <%= page.title || (is_home() ? config.subtitle : '页面') %></title>
  <meta name="description" content="<%= config.description %>">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🕊️</text></svg>">
</head>
<body>
  <header class="site-header">
    <nav class="nav">
      <a class="logo" href="<%= url_for('/') %>"><%= config.title %></a>
      <div class="nav-links">
        <a href="<%= url_for('/') %>" <%= is_home() ? 'class="active"' : '' %>>首页</a>
        <a href="<%= url_for('/categories/Hydronos/') %>" <%= is_category('Hydronos') ? 'class="active"' : '' %>>Hydronos</a>
        <a href="<%= url_for('/archives/') %>" <%= is_archive() ? 'class="active"' : '' %>>归档</a>
      </div>
    </nav>
  </header>

  <main class="container">
    <%- body %>
  </main>

  <footer class="site-footer">
    <p>© <%= new Date().getFullYear() %> <%= config.author %> · Powered by Hexo · 🕊️ Hopes</p>
  </footer>

  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
