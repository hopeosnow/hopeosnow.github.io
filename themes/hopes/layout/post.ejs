<article class="post-single fade-in">
  <h1 class="post-title-lg"><%= page.title %></h1>
  <div class="post-meta">
    <time><%= date(page.date, 'YYYY-MM-DD') %></time>
    <% if (page.categories && page.categories.length) { %>
      <% page.categories.each(function (cat) { %>
        <a class="cat-badge" href="<%= url_for(cat.path) %>"><%= cat.name %></a>
      <% }) %>
    <% } %>
  </div>
  <div class="post-content">
    <%- page.content %>
  </div>
  <div class="back-home"><a href="<%= url_for('/') %>">← 回到首页</a></div>
</article>
